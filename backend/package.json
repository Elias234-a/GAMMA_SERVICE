{
  "name": "gamma-service-backend",
  "version": "1.0.0",
  "description": "Backend for Gamma Service - Sistema de Gestión de Órdenes y Técnicos",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "dev": "nodemon --no-warnings=ExperimentalWarning server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --watchAll --verbose",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "seed": "node --no-warnings=ExperimentalWarning ./seeds/seed.js"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "rate-limiter-flexible": "^2.4.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "api",
    "rest",
    "nodejs"
