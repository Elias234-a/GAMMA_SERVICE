{
  "name": "gamma-service-backend",
  "version": "1.0.0",
  "description": "Backend for Gamma Service - Sistema de Gestión de Órdenes y Técnicos",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "dev": "nodemon --no-warnings=ExperimentalWarning server.js",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch --runInBand",
    "test:coverage": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
    "test:models": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest __tests__/models --runInBand",
    "test:integration": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest __tests__/integration --runInBand",
    "test:ci": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage --runInBand",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "seed": "node --no-warnings=ExperimentalWarning seeds/seedAll.js",
    "seed:vehicles": "node --no-warnings=ExperimentalWarning seeds/seedVehicles.js",
    "seed:clients": "node --no-warnings=ExperimentalWarning seeds/seedClients.js",
    "seed:admin": "node --no-warnings=ExperimentalWarning seeds/seedAdmin.js",
    "seed:clean": "node --no-warnings=ExperimentalWarning seeds/cleanDatabase.js"
  },
  "dependencies": {
    "@sentry/node": "^7.99.0",
    "@sentry/profiling-node": "^7.99.0",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-status-monitor": "^1.3.4",
    "express-validator": "^7.0.1",
    "helmet": "^7.2.0",
    "http-status-codes": "^2.2.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^2.4.1",
    "stripe": "^14.14.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "api",
    "rest",
    "nodejs"
  ],
  "author": "",
  "license": "MIT"
}
