# Server Configuration
PORT=8001
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/gamma_service

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# Sentry Error Tracking (Optional - Get free at https://sentry.io)
# If not set, error tracking will be disabled
SENTRY_DSN=

# DIAN API Configuration
DIAN_API_URL=https://api.dian.com/v1
DIAN_API_KEY=your_dian_api_key

# Datacrédito API Configuration
DATACREDITO_API_URL=https://api.datacredito.com/v1
DATACREDITO_API_KEY=your_datacredito_api_key

# Tránsito API Configuration
TRANSITO_API_URL=https://api.transito.com/v1
TRANSITO_API_KEY=your_transito_api_key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# File Upload Configuration
MAX_FILE_SIZE=5MB
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15*60*1000
RATE_LIMIT_MAX=100

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8001

# Payment Gateways
# Stripe (International)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# MercadoPago (Latam)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Wompi (Colombia)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENT_SECRET=

# PSE (Colombia)
PSE_API_KEY=
PSE_SECRET_KEY=

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=gamma-backups
BACKUP_S3_REGION=us-east-1
# AWS credentials (if S3 enabled) - Use AWS CLI or environment variables
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Redis Configuration (Optional - for caching and rate limiting)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
