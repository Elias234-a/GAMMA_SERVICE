# Configuración del servidor
PORT=5000
NODE_ENV=development

# Base de datos
MONGODB_URI=mongodb://localhost:27017/gamma_service

# Autenticación
JWT_SECRET=tu_clave_secreta_jwt
JWT_EXPIRES_IN=30d

# Configuración de correo (opcional)
SMTP_HOST=smtp.tuservidor.com
SMTP_PORT=587
SMTP_USER=tu_usuario
SMTP_PASS=tu_contraseña
SMTP_FROM=noreply@tudominio.com

# Configuración de la API de DIAN (opcional)
DIAN_API_KEY=tu_api_key_dian
DIAN_API_URL=https://api.dian.gov.co

# Configuración de Datacrédito (opcional)
DATACREDITO_API_KEY=tu_api_key_datacredito
DATACREDITO_API_URL=https://api.datacredito.com

# Configuración de Tránsito (opcional)
TRANSITO_API_KEY=tu_api_key_transito
TRANSITO_API_URL=https://api.transito.com
